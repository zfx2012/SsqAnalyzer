<Window x:Class="SsqAnalyzer.Pages.BacktestProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="回测进度"
        Width="440" Height="200"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource BgContent}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" x:Name="TitleText" Text="回测中..."
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" />

        <!-- 进度条 -->
        <ProgressBar Grid.Row="1" x:Name="ProgressBar"
                     Height="8" Minimum="0" Maximum="100" Value="0"
                     IsIndeterminate="True" />

        <!-- 进度文案 -->
        <TextBlock Grid.Row="2" x:Name="DetailText" Text=""
                   FontSize="12" Margin="0,10,0,0"
                   Foreground="{StaticResource TextSecondary}" />

        <!-- 底部提示 -->
        <TextBlock Grid.Row="3" Text="回测进行中，请勿关闭窗口..."
                   FontSize="11" VerticalAlignment="Bottom"
                   Foreground="{StaticResource TextTertiary}" />
    </Grid>
</Window>
