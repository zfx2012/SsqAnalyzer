<UserControl x:Class="SsqAnalyzer.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgContent}">
    <Grid>
        <StackPanel Margin="16,12">
            <!-- 页面标题 -->
            <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

            <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                    <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderSubtle}" Padding="12,10">
                        <TextBlock>
                            <Run Text="⚙️ " />
                            <Run Text="数据分析配置" FontSize="14" FontWeight="SemiBold" />
                        </TextBlock>
                    </Border>

                    <StackPanel Margin="12">
                        <!-- API 配置 -->
                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderSubtle}" Padding="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="千问 API" FontSize="12" />
                                    <TextBlock x:Name="ApiStatusText" FontSize="10"
                                               Foreground="{StaticResource TextTertiary}"
                                               Text="未配置" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="⚙ API 设置"
                                        Style="{StaticResource PrimaryButton}" Padding="12,4"
                                        VerticalAlignment="Center" Click="ApiSettings_Click" />
                            </Grid>
                        </Border>

                        <!-- 数据更新 -->
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="数据更新" FontSize="12" />
                                <TextBlock FontSize="10" Foreground="{StaticResource TextTertiary}">
                                    <Run Text="数据源" />
                                    <Run Text="data.17500.cn/ssq_asc.txt" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="🔄 更新数据" x:Name="BtnUpdate"
                                    Style="{StaticResource PrimaryButton}" Padding="12,4"
                                    VerticalAlignment="Center" Click="BtnUpdate_Click" />
                        </Grid>

                        <!-- 缓存管理 -->
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSubtle}"
                                Margin="0,8,0,0" Padding="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="历史数据缓存" FontSize="12" />
                                    <TextBlock x:Name="CacheInfo" FontSize="10"
                                               Foreground="{StaticResource TextTertiary}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="清除缓存" x:Name="BtnClearCache"
                                        Style="{StaticResource ActionButton}"
                                        VerticalAlignment="Center" Click="BtnClearCache_Click" />
                            </Grid>
                        </Border>

                        <!-- B站 UID 默认值 -->
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSubtle}"
                                Margin="0,8,0,0" Padding="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="B站 UID 默认值" FontSize="12" />
                                    <TextBlock x:Name="BiliUidStatus" FontSize="10"
                                               Foreground="{StaticResource TextTertiary}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="🔧 UID 设置"
                                        Style="{StaticResource PrimaryButton}" Padding="12,4"
                                        VerticalAlignment="Center" Click="BiliUidSetting_Click" />
                            </Grid>
                        </Border>

                        <!-- LLM API 配置（NL→Code 用：DeepSeek/GLM/Minimax/Kimi 等 OpenAI 兼容） -->
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSubtle}"
                                Margin="0,8,0,0" Padding="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LLM API 配置" FontSize="12" />
                                    <TextBlock x:Name="LlmStatusText" FontSize="10"
                                               Foreground="{StaticResource TextTertiary}" Text="未配置" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="🤖 LLM 设置"
                                        Style="{StaticResource PrimaryButton}" Padding="12,4"
                                        VerticalAlignment="Center" Click="LlmSetting_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 弹窗遮罩层 -->
        <Border x:Name="PopupOverlay" Background="#80000000" Visibility="Collapsed"
                MouseDown="PopupOverlay_MouseDown">
            <Border Width="360" Height="220" Background="{StaticResource BgContent}"
                    CornerRadius="8" BorderBrush="{StaticResource BorderDefault}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock x:Name="PopupIcon" FontSize="36" HorizontalAlignment="Center">⏳</TextBlock>
                    <TextBlock x:Name="PopupText" FontSize="14" Margin="0,8,0,12"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel x:Name="PopupActions" Orientation="Horizontal"
                                HorizontalAlignment="Center" Visibility="Collapsed">
                        <Button x:Name="PopupConfirmBtn" Content="确认" Style="{StaticResource PrimaryButton}"
                                Width="70" Height="28" Margin="0,0,8,0" Click="PopupConfirm_Click" />
                        <Button x:Name="PopupCancelBtn" Content="取消" Style="{StaticResource ActionButton}"
                                Width="70" Height="28" Click="PopupCancel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
