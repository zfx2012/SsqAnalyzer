<Window x:Class="SsqAnalyzer.Pages.LlmApiConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LLM API 配置"
        Width="560" Height="300"
        MinWidth="480" MinHeight="260"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgContent}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="LLM API 配置：" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12" />

        <!-- 行1：模型预设 + 地址（同一行） -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="模型预设：" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" x:Name="PresetBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                      SelectionChanged="PresetBox_SelectionChanged" FontSize="12" />
            <TextBlock Grid.Column="2" Text="地址：" FontSize="12" VerticalAlignment="Center" Margin="10,0,6,0" />
            <TextBox Grid.Column="3" x:Name="UrlBox" FontSize="12" Padding="4,3"
                     VerticalContentAlignment="Center" />
        </Grid>

        <!-- 行2：API Key -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="API Key：" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
            <PasswordBox Grid.Column="1" x:Name="ApiKeyBox" FontSize="12" Padding="4,3" />
        </Grid>

        <!-- 行3：模型名 + 获取模型 + 测试API -->
        <Grid Grid.Row="3" VerticalAlignment="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="模型名：" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox Grid.Column="1" x:Name="ModelBox" IsEditable="True" FontSize="12" />
            <Button Grid.Column="2" x:Name="BtnFetchModels" Content="获取模型" Margin="8,0,0,0"
                    Style="{StaticResource ActionButton}" Padding="12,4" Click="FetchModels_Click" />
            <Button Grid.Column="3" x:Name="BtnTest" Content="测试API" Margin="8,0,0,0"
                    Style="{StaticResource ActionButton}" Padding="12,4" Click="TestApi_Click" />
        </Grid>

        <!-- 状态信息 + 保存按钮（底部） -->
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11"
                       Foreground="{StaticResource TextTertiary}" TextWrapping="Wrap" />
            <Button Grid.Column="1" x:Name="BtnSave" Content="保存配置"
                    Style="{StaticResource PrimaryButton}" Padding="16,6"
                    Click="Save_Click" />
        </Grid>
    </Grid>
</Window>