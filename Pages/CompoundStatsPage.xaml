<UserControl x:Class="SsqAnalyzer.Pages.CompoundStatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F6FA"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <SolidColorBrush x:Key="WorkflowTint" Color="#F2F8FD" />
        <SolidColorBrush x:Key="WorkflowTintStrong" Color="#E4F2FD" />
        <SolidColorBrush x:Key="WorkflowInkMuted" Color="#6F7D8C" />

        <Style x:Key="WorkflowCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#DCE4EC" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#26384A" BlurRadius="12" ShadowDepth="2" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style x:Key="SectionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource WorkflowInkMuted}" />
        </Style>

        <Style x:Key="PanelCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        </Style>

        <Style x:Key="InnerSurface" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgContent}" />
            <Setter Property="BorderBrush" Value="#DDE5EC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="WorkflowListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="3,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Marker" Width="3" Margin="-8,2,0,2"
                                        HorizontalAlignment="Left" Background="{StaticResource Accent}"
                                        CornerRadius="2" Opacity="0" />
                                <ContentPresenter Margin="4,0,0,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource BgHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource WorkflowTintStrong}" />
                                <Setter TargetName="Marker" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDownloadable}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.72" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkflowPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentHover}" />
                                <Setter Property="BorderBrush" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkflowGhostButton" TargetType="Button" BasedOn="{StaticResource WorkflowPrimaryButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="#B8D8F0" />
        </Style>

        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="#DEE7EF" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="PART_Track">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="3" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="复式票数据工作台" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" />
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Border Background="{StaticResource WorkflowTintStrong}" CornerRadius="10" Padding="8,3">
                        <TextBlock Text="视频  →  号码  →  数据" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}" />
                    </Border>
                    <TextBlock Text="从公开视频识别复式票并保存到本地" FontSize="11"
                               Foreground="{StaticResource WorkflowInkMuted}" Margin="10,3,0,0" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="查看复式票统计  →"
                    Style="{StaticResource WorkflowGhostButton}" VerticalAlignment="Center"
                    Click="OpenTicketStats_Click" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ManualPanel" Margin="2,0,8,8">
                <!-- 01：输入视频来源 -->
                <Border Style="{StaticResource WorkflowCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepBadge}" Margin="0,0,12,0">
                            <TextBlock Text="01" Foreground="White" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="搜索视频" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="B站UID或视频链接" Style="{StaticResource SectionHint}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBox x:Name="SearchBox" Grid.Column="2" Height="38" FontSize="12"
                                 Margin="12,0" Padding="11,0"
                                 Background="White" Foreground="{StaticResource TextTertiary}"
                                 BorderBrush="#CCD8E3" BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus" />
                        <Button Grid.Column="3" Content="搜索视频"
                                Style="{StaticResource WorkflowPrimaryButton}"
                                Click="SearchVideo_Click" MinWidth="104" />
                    </Grid>
                </Border>

                <!-- 02：选择并下载 -->
                <Border Style="{StaticResource WorkflowCard}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepBadge}" Margin="0,0,12,0">
                                <TextBlock Text="02" Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="选择并下载" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="选择搜索结果，确认画质后下载到本地"
                                           Style="{StaticResource SectionHint}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Height="228" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="440" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource InnerSurface}" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="6,2,6,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="搜索结果" Style="{StaticResource PanelCaption}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SearchResults.Count, StringFormat={}{0} 个结果}"
                                                   FontSize="10" Foreground="{StaticResource WorkflowInkMuted}" />
                                    </Grid>
                                    <ListBox x:Name="PreviewList" Grid.Row="1" SelectionMode="Single"
                                             ItemsSource="{Binding SearchResults}"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimary}"
                                             ItemContainerStyle="{StaticResource WorkflowListItem}"
                                             SelectionChanged="PreviewList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="ResultIconBackground" Width="24" Height="24" CornerRadius="6"
                                                            Background="{StaticResource WorkflowTintStrong}"
                                                            VerticalAlignment="Center">
                                                        <TextBlock x:Name="ResultIcon" Text="▶" FontSize="9" Foreground="{StaticResource Accent}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding TitleWithExt}" FontSize="11.5"
                                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel x:Name="ResultMeta" Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock Text="{Binding Author}" FontSize="9.5"
                                                                       Foreground="{StaticResource WorkflowInkMuted}" />
                                                            <TextBlock Text="  ·  " FontSize="9.5"
                                                                       Foreground="{StaticResource BorderDefault}" />
                                                            <TextBlock Text="{Binding Duration}" FontSize="9.5"
                                                                       Foreground="{StaticResource WorkflowInkMuted}" />
                                                            <TextBlock Text="  ·  " FontSize="9.5"
                                                                       Foreground="{StaticResource BorderDefault}" />
                                                            <TextBlock Text="{Binding Play, StringFormat={}{0:N0} 次播放}" FontSize="9.5"
                                                                       Foreground="{StaticResource WorkflowInkMuted}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsDownloadable}" Value="False">
                                                        <Setter TargetName="ResultIcon" Property="Text" Value="!" />
                                                        <Setter TargetName="ResultIcon" Property="FontWeight" Value="Bold" />
                                                        <Setter TargetName="ResultIcon" Property="Foreground" Value="#C06B16" />
                                                        <Setter TargetName="ResultIconBackground" Property="Background" Value="#FFF1DE" />
                                                        <Setter TargetName="ResultMeta" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource InnerSurface}"
                                    Margin="12,0,0,0" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource Accent}" CornerRadius="2" />
                                        <TextBlock Grid.Column="1" Text="下载设置" Style="{StaticResource PanelCaption}"
                                                   Margin="8,0,0,0" />
                                    </Grid>

                                    <Border Grid.Row="1" Background="{StaticResource WorkflowTint}"
                                            CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <Grid>
                                            <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                                                <TextBlock x:Name="DetailTitle" FontSize="13" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" Foreground="{StaticResource TextPrimary}"
                                                           Margin="0,0,0,8" />
                                                <WrapPanel>
                                                    <TextBlock x:Name="DetailAuthor" FontSize="10.5"
                                                               Foreground="{StaticResource TextSecondary}" Margin="0,0,14,4" />
                                                    <TextBlock x:Name="DetailDuration" FontSize="10.5"
                                                               Foreground="{StaticResource WorkflowInkMuted}" Margin="0,0,14,4" />
                                                    <TextBlock x:Name="DetailPlay" FontSize="10.5"
                                                               Foreground="{StaticResource WorkflowInkMuted}" />
                                                </WrapPanel>
                                            </StackPanel>

                                            <StackPanel x:Name="NoSelection" HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <Border Width="38" Height="38" CornerRadius="19"
                                                        Background="{StaticResource WorkflowTintStrong}"
                                                        HorizontalAlignment="Center" Margin="0,0,0,8">
                                                    <TextBlock Text="▶" FontSize="12" Foreground="{StaticResource Accent}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="从左侧选择一个视频" FontSize="11"
                                                           Foreground="{StaticResource WorkflowInkMuted}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <StackPanel x:Name="QualityPanel" Grid.Row="2" Visibility="Collapsed"
                                                Orientation="Horizontal" Margin="2,0,0,9">
                                        <TextBlock Text="下载清晰度" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <RadioButton x:Name="Rd720P" Content="720P" GroupName="Quality"
                                                     FontSize="10.5" Foreground="{StaticResource TextPrimary}"
                                                     IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <RadioButton x:Name="Rd480P" Content="480P" GroupName="Quality"
                                                     FontSize="10.5" Foreground="{StaticResource TextPrimary}"
                                                     VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Grid Grid.Row="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar x:Name="DownloadProgress" Style="{StaticResource SlimProgress}"
                                                         Minimum="0" Maximum="100" Value="0"
                                                         Visibility="Collapsed" VerticalAlignment="Center"
                                                         Margin="0,0,12,0" />
                                            <Button x:Name="DownloadBtn" Grid.Column="1" Content="下载视频  ↓"
                                                    Style="{StaticResource WorkflowPrimaryButton}"
                                                    Click="DownloadVideo_Click" MinWidth="112" IsEnabled="False" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="2,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="DownloadSpinner" Text="⌛" FontSize="11"
                                                       Visibility="Collapsed" Margin="0,0,6,0" />
                                            <TextBlock x:Name="DownloadStatus" Grid.Column="1" FontSize="10"
                                                       Foreground="{StaticResource WorkflowInkMuted}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 03：AI 识别并保存 -->
                <Border Style="{StaticResource WorkflowCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepBadge}" Margin="0,0,12,0">
                                <TextBlock Text="03" Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="AI 识别并保存" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="选择本地视频，识别复式票号码并保存到数据目录"
                                           Style="{StaticResource SectionHint}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Height="202" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="440" />
                                <ColumnDefinition Width="400" />
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource InnerSurface}" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="6,2,6,7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="本地视频" Style="{StaticResource PanelCaption}" />
                                        <TextBlock Grid.Column="1" Text="按期号从新到旧"
                                                   FontSize="10" Foreground="{StaticResource WorkflowInkMuted}" />
                                    </Grid>
                                    <ListBox x:Name="LocalList" Grid.Row="1" SelectionMode="Single"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource TextPrimary}"
                                             FontFamily="Segoe UI" FontSize="11"
                                             ItemContainerStyle="{StaticResource WorkflowListItem}">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="删除选中文件" Click="DeleteLocalVideo_Click" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource InnerSurface}"
                                    Margin="12,0,0,0" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource Accent}" CornerRadius="2" />
                                        <TextBlock Grid.Column="1" Text="识别任务" Style="{StaticResource PanelCaption}"
                                                   Margin="8,0,0,0" />
                                    </Grid>

                                    <Border Grid.Row="1" Background="{StaticResource WorkflowTint}"
                                            CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="38" Height="38" CornerRadius="19"
                                                    Background="{StaticResource WorkflowTintStrong}"
                                                    HorizontalAlignment="Center" Margin="0,0,0,8">
                                                <TextBlock Text="✦" FontSize="16" Foreground="{StaticResource Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="AnalyzeStatus" FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap" TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Text="选择左侧视频开始识别" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar x:Name="AnalyzeProgress" Style="{StaticResource SlimProgress}"
                                                     Minimum="0" Maximum="100" Value="0"
                                                     Visibility="Collapsed" VerticalAlignment="Center"
                                                     Margin="0,0,12,0" />
                                        <Button x:Name="AnalyzeBtn" Grid.Column="1" Content="开始识别  ✦"
                                                Style="{StaticResource WorkflowPrimaryButton}"
                                                Click="AnalyzeVideo_Click" MinWidth="118" />
                                    </Grid>

                                    <TextBlock x:Name="AnalyzeTip" Grid.Row="3" FontSize="10"
                                               Foreground="{StaticResource WorkflowInkMuted}" Margin="2,7,0,0"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
