<UserControl x:Class="SsqAnalyzer.Pages.KillPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgContent}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======== 顶部：标题 + 期数选择 + 操作按钮 ======== -->
        <Grid Margin="16,12,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="杀号规则"
                       FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Style="{StaticResource PanelBorder}" Padding="6,2" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="回测触发次数：" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextTertiary}" Margin="4,0,4,0" />
                    <Button x:Name="Btn30" Content="30" Style="{StaticResource FilterTab}"
                            Click="PeriodBtn_Click" Tag="30" Margin="1,0" />
                    <Button x:Name="Btn50" Content="50" Style="{StaticResource FilterTabActive}"
                            Click="PeriodBtn_Click" Tag="50" Margin="1,0" />
                    <Button x:Name="Btn100" Content="100" Style="{StaticResource FilterTab}"
                            Click="PeriodBtn_Click" Tag="100" Margin="1,0" />
                    <Button x:Name="BtnAll" Content="全部" Style="{StaticResource FilterTab}"
                            Click="PeriodBtn_Click" Tag="0" Margin="1,0" />
                    <Separator Width="1" Background="{StaticResource BorderSubtle}" Margin="8,2,6,2" />
                    <TextBlock x:Name="PeriodInfo" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextTertiary}" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="提交记录" Style="{StaticResource ActionButton}" Click="SubmissionHistory_Click" Margin="0,0,8,0" ToolTip="查看提交记录及开奖后的错杀复盘" />
                <Button x:Name="BtnAddRule" Content="➕ 添加规则" Style="{StaticResource ActionButton}"
                        Click="AddRule_Click" Margin="0,0,8,0" />
                <Button x:Name="BtnBatchBacktest" Content="📊 回测全部" Style="{StaticResource ActionButton}"
                        Click="BatchBacktest_Click" Margin="0,0,8,0" ToolTip="回测规则库中的全部规则，不受列表搜索和筛选影响" />
                <Button x:Name="BtnRunKill" Content="▶ 执行杀号" Style="{StaticResource PrimaryButton}"
                        Click="RunKill_Click" ToolTip="使用规则库中所有已启用规则执行杀号，不受列表筛选影响" />
            </StackPanel>
        </Grid>

        <!-- ======== 主体：全宽规则列表表格 ======== -->
        <StackPanel x:Name="WorkflowHost" Grid.Row="1" Margin="16,0,16,8" />
        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="16,0,16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderSubtle}" Padding="12,8">
                    <StackPanel>
                      <WrapPanel>
                        <TextBlock Text="规则列表" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="RuleListSummary" Text="" FontSize="11" Margin="8,0,0,0"
                                   Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                      </WrapPanel>
                      <WrapPanel Margin="0,8,0,0">
                        <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="RuleSearch" Width="240" Padding="6,4" Margin="0,0,12,0"
                                 ToolTip="搜索规则 ID、名称和描述" TextChanged="RuleSearch_TextChanged" />
                        <ComboBox x:Name="BallFilter" Width="100" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged">
                          <ComboBoxItem Content="全部球种" /><ComboBoxItem Content="红球" /><ComboBoxItem Content="蓝球" />
                        </ComboBox>
                        <ComboBox x:Name="StateFilter" Width="100" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="Filter_SelectionChanged">
                          <ComboBoxItem Content="全部状态" /><ComboBoxItem Content="已启用" /><ComboBoxItem Content="未启用" />
                        </ComboBox>
                        <CheckBox x:Name="HideFailedCheckBox" Content="隐藏不达标" VerticalAlignment="Center" Margin="0,0,12,0"
                                  Checked="HideFailed_Changed" Unchecked="HideFailed_Changed"
                                  ToolTip="隐藏当前窗口判定为不达标的规则；保留待判定和强制启用规则。仅影响列表显示。" />
                        <Button Content="重置列表" Click="ResetList_Click" Style="{StaticResource ActionButton}" ToolTip="清空搜索和筛选，恢复默认排序" />
                        <TextBlock Text="点击表头：升序 / 降序 / 默认 · 双击或 Enter 查看详情" FontSize="11"
                                   Margin="12,4,0,0" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
                      </WrapPanel>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="RulesGrid" Grid.Row="1"
                          AutoGenerateColumns="False" CanUserSortColumns="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeColumns="True"
                          IsReadOnly="True" HeadersVisibility="Column"
                          BorderThickness="0"
                          Background="{StaticResource BgSurface}"
                          Foreground="{StaticResource TextPrimary}"
                          AlternationCount="2"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="{StaticResource BorderSubtle}"
                          VerticalGridLinesBrush="{StaticResource BorderSubtle}"
                          RowHeaderWidth="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          SelectionMode="Extended"
                          FrozenColumnCount="3"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="RulesGrid_MouseDoubleClick"
                          KeyDown="RulesGrid_KeyDown"
                          Sorting="RulesGrid_Sorting">
                    <DataGrid.Resources>
                        <!-- 直接把系统选中画刷设为目标颜色（#2D4373），
                             DataGridRow 默认模板的 IsSelected 触发器会用这个画刷画 Border 背景 -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2D4373"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2D4373"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/>
                        <!-- 表头样式：暗色风格，与 RecordsPage 一致 -->
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BgElevated}" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
                            <Setter Property="Padding" Value="6,4" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                        <!-- 单元格样式：IsSelected 时保持透明背景（让行选中色透出），文字转白保证可读性 -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Height" Value="32" />
                            <Setter Property="Focusable" Value="False" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <!-- 行样式：隔行底色用 AlternationIndex 触发器实现（不抢占 IsSelected 的本地值），
                             选中高亮（深蓝 #2D4373，整行白字）放在最后，优先级最高 -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="Height" Value="32" />
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F5F5F5" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                    <Setter Property="Opacity" Value="0.78" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BgHover}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#2D4373" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                    <Setter Property="Opacity" Value="1" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- 1. 序号 -->
                        <DataGridTextColumn Header="#" Width="36" Binding="{Binding Index}" CanUserSort="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 2. 启用（CheckBox，OneWay 绑定 + Click 持久化） -->
                        <DataGridTemplateColumn Header="启用" Width="46" SortMemberPath="IsEnabled">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="按启用状态排序；勾选时保留行位置，再次点击表头按最新状态排序" />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Cursor="Hand" Click="EnabledCheckBox_Click" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 3. 规则ID（等宽字体） -->
                        <DataGridTextColumn Header="规则ID" Width="180" Binding="{Binding RuleId}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 4. 规则名 -->
                        <DataGridTextColumn Header="规则名" Width="160" Binding="{Binding Name}" SortMemberPath="Name">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Name}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 5. 红球/蓝球 -->
                        <DataGridTextColumn Header="球种" Width="56" Binding="{Binding BallTypeLabel}"
                                            SortMemberPath="BallTypeLabel">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 6. 类别 -->
                        <DataGridTextColumn Header="类别" Width="50" Binding="{Binding CategoryLabel}"
                                            SortMemberPath="CategoryLabel">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 7. 来源 -->
                        <DataGridTextColumn Header="来源" Width="56" Binding="{Binding SourceLabel}"
                                            SortMemberPath="SourceLabel">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 8. 规则描述（占满剩余宽度） -->
                        <DataGridTextColumn Header="规则描述" Width="*" MinWidth="150" Binding="{Binding Description}" SortMemberPath="Description">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Description}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 9. 准确率（带颜色） -->
                        <DataGridTemplateColumn Header="准确率" Width="80" SortMemberPath="AccuracyValue">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AccuracyLabel}"
                                               ToolTip="{Binding StatsHint}"
                                               
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontSize="11" >
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Foreground" Value="{Binding AccuracyBrush}" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                              <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 10. 门槛 -->
                        <DataGridTextColumn Header="门槛" Width="50" Binding="{Binding MinAccuracyLabel}" CanUserSort="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 11. 达标情况（带颜色） -->
                        <DataGridTemplateColumn Header="窗口判定" Width="80" SortMemberPath="GateSortValue">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GateLabel}"
                                               
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" >
                                      <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                          <Setter Property="Foreground" Value="{Binding GateBrush}" />
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                              <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- 12. 操作：单规则回测 -->
                        <DataGridTemplateColumn Header="操作" Width="112" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                  <StackPanel Orientation="Horizontal">
                                    <Button Content="详情" Style="{StaticResource ActionButton}" FontSize="11" Padding="8,2" Margin="2,0" Click="DetailsBtn_Click" />
                                    <Button Content="回测" Style="{StaticResource ActionButton}"
                                            FontSize="11" Padding="8,2" Margin="2,0"
                                            Cursor="Hand" Click="BacktestBtn_Click" />
                                  </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="EmptyHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource TextTertiary}" Visibility="Collapsed" IsHitTestVisible="False" />

                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderSubtle}" Padding="12,6">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ThresholdValue" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="6,0,12,0" FontFamily="Consolas" />
                        <TextBlock x:Name="RuleFooter" FontSize="11" Foreground="{StaticResource TextTertiary}"
                                   VerticalAlignment="Center" Text="勾选规则后点「执行杀号」生成报告" />
                    </WrapPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
